{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "SkillMatch Oceanic Intelligence Design Tokens",
  "version": "1.0.0",
  "source": "https://skillmatchapp-ten.vercel.app/",
  "dimensions": {
    "aspectRatio": "16:9",
    "widthInches": 13.333,
    "heightInches": 7.5,
    "safeArea": {
      "topInches": 0.6,
      "bottomInches": 0.6,
      "leftInches": 0.8,
      "rightInches": 0.8,
      "contentWidth": 11.733,
      "contentHeight": 6.3
    }
  },
  "colors": {
    "brand": {
      "primaryTeal": "#004049",
      "pineContainer": "#095964",
      "technicalMint": "#00D4BE",
      "cyanGlow": "#67E8F9",
      "softSky": "#A5F3FC",
      "deepObsidian": "#051C19",
      "forestDark": "#0D3E35"
    },
    "surfaces": {
      "darkCanvas": "#14151C",
      "darkCard": "#121920",
      "darkCardElevated": "#1A222D",
      "darkBorder": "#1E293B",
      "lightCanvas": "#F8F9FF",
      "lightCard": "#FFFFFF",
      "lightCardSubtle": "#EEF4FF",
      "lightBorder": "#CBD5E1"
    },
    "text": {
      "onDarkPrimary": "#FFFFFF",
      "onDarkSecondary": "#94A3B8",
      "onDarkMuted": "#64748B",
      "onLightPrimary": "#131C26",
      "onLightSecondary": "#3F484A",
      "onLightMuted": "#6F797B"
    },
    "accents": {
      "gapWarningCoral": "#E42520",
      "gapWarningContainer": "#FFDAD6",
      "successGreen": "#10B981",
      "infoBlue": "#0284C7",
      "purpleAI": "#A855F7"
    }
  },
  "typography": {
    "fontFamilies": {
      "display": "Arial, Helvetica, sans-serif",
      "headings": "Arial, Helvetica, sans-serif",
      "body": "Calibri, Arial, sans-serif",
      "monospace": "Courier New, monospace"
    },
    "scale": {
      "coverTitle": { "sizePt": 40, "weight": "bold", "lineSpacing": 1.1 },
      "coverSubtitle": { "sizePt": 18, "weight": "normal", "lineSpacing": 1.2 },
      "slideTitle": { "sizePt": 24, "weight": "bold", "lineSpacing": 1.15 },
      "slideSubtitle": { "sizePt": 13, "weight": "normal", "lineSpacing": 1.2 },
      "sectionHeader": { "sizePt": 16, "weight": "bold", "lineSpacing": 1.2 },
      "cardTitle": { "sizePt": 14, "weight": "bold", "lineSpacing": 1.2 },
      "bodyLarge": { "sizePt": 13, "weight": "normal", "lineSpacing": 1.25 },
      "bodyRegular": { "sizePt": 11, "weight": "normal", "lineSpacing": 1.25 },
      "bodySmall": { "sizePt": 9.5, "weight": "normal", "lineSpacing": 1.2 },
      "metricLarge": { "sizePt": 34, "weight": "bold", "lineSpacing": 1.0 },
      "badge": { "sizePt": 8.5, "weight": "bold", "lineSpacing": 1.0 },
      "footnote": { "sizePt": 8, "weight": "normal", "lineSpacing": 1.1 }
    }
  },
  "spacingScale": {
    "xs": 0.08,
    "sm": 0.15,
    "md": 0.25,
    "lg": 0.4,
    "xl": 0.6,
    "xxl": 0.8
  },
  "borders": {
    "hairline": { "widthPt": 1, "color": "#1E293B" },
    "subtle": { "widthPt": 1.5, "color": "#095964" },
    "accent": { "widthPt": 2, "color": "#00D4BE" }
  },
  "radii": {
    "cardInches": 0.18,
    "pillInches": 0.35,
    "badgeInches": 0.08
  }
