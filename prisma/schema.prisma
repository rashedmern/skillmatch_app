// ==============================================================================
// SkillMatch - Enterprise Prisma Database Schema
// Modeled directly from Chen Notation ER Diagram and Relational Schema
// Target Database: Supabase PostgreSQL (Connection Pooling & Direct Migration)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// 1. Core Identity & Authentication Entities
// ------------------------------------------------------------------------------

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password_hash     String?
  name              String
  role              String             @default("candidate") // "candidate" | "recruiter"
  auth_provider     String             @default("email")     // "email" | "google" | "github"
  is_email_verified Boolean            @default(false)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  // 1:1 Identity Profiles
  candidate_profile CandidateProfile?
  recruiter_profile RecruiterProfile?

  // 1:N Relationships
  sessions          Session[]
  otp_tokens        OtpToken[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model OtpToken {
  id         String   @id @default(uuid())
  user_id    String?
  email      String
  code_hash  String
  consumed   Boolean  @default(false)
  expires_at DateTime

  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("otp_tokens")
}

// ------------------------------------------------------------------------------
// 2. Candidate Domain & AST Code Verification Entities
// ------------------------------------------------------------------------------

model CandidateProfile {
  id               String           @id @default(uuid())
  user_id          String           @unique
  headline         String?
  university       String?
  degree           String?
  graduation_year  String?
  github_username  String?
  linkedin_url     String?
  portfolio_url    String?
  resume_file_url  String?
  resume_sha256    String?
  updated_at       DateTime         @updatedAt

  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // 1:N & M:N Relationships
  candidate_skills CandidateSkill[]
  ast_metrics      AstMetric[]
  applications     Application[]

  @@map("candidate_profiles")
}

model Skill {
  id               String           @id @default(uuid())
  name             String           @unique
  category         String?

  // M:N Junctions
  candidate_skills CandidateSkill[]
  job_skills       JobSkill[]
  track_skills     TrackSkill[]

  @@map("skills")
}

model CandidateSkill {
  candidate_id String
  skill_id     String
  proficiency  String?          // e.g. "Advanced", "Intermediate"
  is_verified  Boolean          @default(false)
  verified_at  DateTime?

  candidate    CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  skill        Skill            @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([candidate_id, skill_id])
  @@map("candidate_skills")
}

model AstMetric {
  id                   String           @id @default(uuid())
  candidate_id         String
  repository_url       String
  commit_hash          String
  nodes_analyzed       Int              @default(0)
  overall_score        Float
  algorithmic_score    Float
  concurrency_score    Float
  memory_safety_score  Float

  candidate            CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@index([candidate_id])
  @@map("ast_metrics")
}

// ------------------------------------------------------------------------------
// 3. Recruiter Domain & Corporate Entities
// ------------------------------------------------------------------------------

model Company {
  id                  String             @id @default(uuid())
  name                String
  slug                String             @unique
  domain              String?
  industry            String?
  is_verified_partner Boolean            @default(true)
  created_at          DateTime           @default(now())

  recruiter_profiles  RecruiterProfile[]
  job_postings        JobPosting[]

  @@map("companies")
}

model RecruiterProfile {
  id              String       @id @default(uuid())
  user_id         String       @unique
  company_id      String
  role_title      String?
  office_location String?
  updated_at      DateTime     @updatedAt

  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)

  job_postings    JobPosting[]

  @@map("recruiter_profiles")
}

model JobPosting {
  id              String        @id @default(uuid())
  company_id      String
  recruiter_id    String
  title           String
  team            String?
  location        String
  work_model      String        // "Remote", "Hybrid", "On-site"
  min_salary      String?
  max_salary      String?
  min_match_score Float         @default(85.0)
  status          String        @default("Active") // "Active", "Paused", "Closed"
  description     String
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  company         Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  recruiter       RecruiterProfile @relation(fields: [recruiter_id], references: [id], onDelete: Cascade)

  job_skills      JobSkill[]
  applications    Application[]

  @@index([company_id])
  @@index([recruiter_id])
  @@map("job_postings")
}

model JobSkill {
  job_id       String
  skill_id     String
  is_mandatory Boolean    @default(true)
  weight       Float      @default(1.0)

  job          JobPosting @relation(fields: [job_id], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([job_id, skill_id])
  @@map("job_skills")
}

// ------------------------------------------------------------------------------
// 4. CSE Tracks & Specialization Entities
// ------------------------------------------------------------------------------

model CseTrack {
  id               String       @id @default(uuid())
  title            String
  category         String?
  icon_name        String?
  benchmark_metric String?

  track_skills     TrackSkill[]

  @@map("cse_tracks")
}

model TrackSkill {
  track_id String
  skill_id String
  priority Int      @default(1)

  track    CseTrack @relation(fields: [track_id], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@id([track_id, skill_id])
  @@map("track_skills")
}

// ------------------------------------------------------------------------------
// 5. Application Pipeline & Stage Audit Entities
// ------------------------------------------------------------------------------

model Application {
  id            String                    @id @default(uuid())
  candidate_id  String
  job_id        String
  match_score   Float
  stage         String                    @default("Under Review") // "Under Review", "Assessment Passed", "Interview Scheduled", "Offer Extended", "Rejected"
  applied_at    DateTime                  @default(now())
  updated_at    DateTime                  @updatedAt

  candidate     CandidateProfile          @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job           JobPosting                @relation(fields: [job_id], references: [id], onDelete: Cascade)

  stage_history ApplicationStageHistory[]

  @@index([candidate_id])
  @@index([job_id])
  @@map("applications")
}

model ApplicationStageHistory {
  id             String      @id @default(uuid())
  application_id String
  from_stage     String?
  to_stage       String
  notes          String?
  changed_at     DateTime    @default(now())

  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
  @@map("application_stage_history")
}
