# ==============================================================================
# SkillMatch - Enterprise Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or set these environment
# variables directly in your hosting provider (Vercel, AWS ECS, GCP Cloud Run, Docker).
# ==============================================================================

# 1. Base Canonical Application URL (Mandatory for OAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# 2. Cryptographic Session & JWT Encryption Secrets (Mandatory, min 32 chars)
# Auth.js v5 uses AUTH_SECRET; NextAuth v4 uses NEXTAUTH_SECRET.
AUTH_SECRET="skillmatch-production-secure-32-character-random-salt-key-2026"
NEXTAUTH_SECRET="skillmatch-production-secure-32-character-random-salt-key-2026"

# 3. Google OAuth 2.0 Credentials (Mandatory for Institutional Google SSO)
# Authorized redirect URI: ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. GitHub OAuth 2.0 Credentials (Mandatory for Verified Repo Handshake)
# Authorized callback URL: ${NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# 5. Production Database Connection URL (PostgreSQL / Prisma / Drizzle)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skillmatch?schema=public"
