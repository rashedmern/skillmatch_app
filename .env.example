# ==============================================================================
# SkillMatch - Enterprise Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or set these environment
# variables directly in your hosting provider (Vercel, AWS ECS, GCP Cloud Run, Docker).
# ==============================================================================

# 1. Base Canonical Application URL (Mandatory for OAuth callbacks)
# Local development: "http://localhost:3000"
# Vercel Production: Set to your canonical domain (e.g. "https://your-domain.vercel.app")
# NOTE: DO NOT set NEXTAUTH_URL to http://localhost:3000 in Vercel project environment variables!
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# 2. Vercel Host Trusting (Mandatory for Auth.js v5 on reverse proxies and Vercel edge)
AUTH_TRUST_HOST="true"

# 3. Cryptographic Session & JWT Encryption Secrets (Mandatory, min 32 chars)
# Auth.js v5 uses AUTH_SECRET; NextAuth v4 uses NEXTAUTH_SECRET.
AUTH_SECRET="skillmatch-production-secure-32-character-random-salt-key-2026"
NEXTAUTH_SECRET="skillmatch-production-secure-32-character-random-salt-key-2026"

# 4. Google OAuth 2.0 Credentials (Mandatory for Institutional Google SSO)
# Authorized redirect URI in Google Cloud Console:
# Local:       http://localhost:3000/api/auth/callback/google
# Production:  https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 5. GitHub OAuth 2.0 Credentials (Mandatory for Verified Repo Handshake)
# Setup Guide: See docs/GITHUB_OAUTH_SETUP.md for complete branding walkthrough.
# To display strictly "SkillMatch" without personal developer names or avatars:
# - Application name:        SkillMatch
# - Homepage URL:            https://your-domain.vercel.app (or http://localhost:3000)
# - Application description: SkillMatch — Autonomous Skill Verification and Candidate Matching Platform for CSE Talent
# - Application logo:        Upload public/images/skillmatch-oauth-logo.png (512x512 PNG)
# - Organization Ownership:  Transfer OAuth App to a free GitHub Organization (e.g. @SkillMatchOfficial)
#                            to eliminate "by @<personal-username>" on the consent screen.
#
# Authorized callback URLs in GitHub Settings:
# Local Development: http://localhost:3000/api/auth/callback/github
# Production:        https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# 6. Production Database Connection URL (PostgreSQL / Prisma / Drizzle)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skillmatch?schema=public"

# 7. Real-Time Email & OTP Delivery Service (Resend API or Nodemailer SMTP)
# SkillMatch automatically checks for RESEND_API_KEY first; if absent, it checks SMTP_HOST.
# If neither is configured, OTP codes are logged to server console for zero-config local testing.

# Option A: Resend API (Recommended for modern serverless / Vercel)
# Sign up at https://resend.com to generate an API key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SkillMatch Verification <onboarding@resend.dev>"

# Option B: Standard SMTP (Gmail App Password, AWS SES, SendGrid, Brevo, custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="SkillMatch Verification <your-email@gmail.com>"

